{
  "name": "bagage-translate",
  "private": true,
  "type": "module",
  "description": "Translation service of the Bagage app: Claude behind a Cloudflare Worker, cached in KV.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "logs": "wrangler tail",
    "eval": "tsx eval/run.ts",
    "figures": "wrangler d1 execute bagage-counts --remote --file figures.sql"
  },
  "devDependencies": {
    "wrangler": "^4.162.0",
    "tsx": "^4.23.15"
  }
}
