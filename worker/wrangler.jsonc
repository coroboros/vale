{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bagage",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "observability": { "enabled": true },
  // The app itself (built into ../dist by `npm run build` at the repository root). Only
  // /translate wakes the Worker; every other request is a static file.
  "assets": { "directory": "../dist", "run_worker_first": ["/translate"] },
  // Workers AI: billed in Neurons on the Workers plan (10,000 free a day).
  "ai": { "binding": "AI" },
  "vars": {
    // Other origins allowed to call /translate: local dev servers and the GitHub Pages preview.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://coroboros.github.io"
    // Monthly ceiling for Claude in USD (default 10), counted in KV from each response's usage.
    // "CLAUDE_BUDGET_USD": "10",
    // Workers AI models per course, tried in order after Claude. Defaults in src/workers-ai.ts;
    // measure with `npm run eval`.
    // "MODELS": { "es": ["@cf/…"], "it": ["@cf/…"], "default": ["@cf/…"] }
  },
  // Created on the first deploy (automatic provisioning).
  "kv_namespaces": [{ "binding": "CACHE" }],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      // Per IP and per Cloudflare location. The period must be 10 or 60 seconds.
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
